{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@websocket/*": ["./src/websocket/*"],
      "@rabbitmq/*": ["./src/rabbitmq/*"],
      "@redis/*": ["./src/redis/*"],
      "@modules/*": ["./src/modules/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "types": [
      "node",
      "jest"
    ]
  },

  "include": ["src"]
}
